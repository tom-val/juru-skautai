# `npm run dev:local` — run the frontend against the local tracker API
# (backend: `npm run local`, LocalStack DynamoDB on :4567). No Cognito: the lead
# below is signed in automatically (dev builds only; see src/auth/cognito.ts).
VITE_API_URL=http://localhost:3001
VITE_USER_POOL_ID=local_dev
VITE_USER_POOL_CLIENT_ID=local
VITE_DEV_LEAD={"sub":"lead-a","email":"asta@example.lt","name":"Asta Vadovė","tuntas":"Kauno jūrų skautų tuntas"}
